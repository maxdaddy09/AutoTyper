<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>AutoTyper</Product>
    <Description>Types pasted text into any window, as real keystrokes, when you press a hotkey.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoTyper.Core\AutoTyper.Core.csproj" />
  </ItemGroup>

</Project>